# ═══════════════════════════════════════════
# 炼丹炉 · 金丹化性系统 - 环境变量配置
# Alchemy Furnace Skill-Persona System - Environment
# ═══════════════════════════════════════════

# ─── 数据库配置 ───
DB_HOST=postgres
DB_PORT=5432
DB_USER=alchemy
DB_PASSWORD=alchemy123
DB_NAME=alchemy_db

# ─── LLM 配置 ───
# OpenAI 或兼容接口（如 DeepSeek、通义千问、智谱等）
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o

# ─── 语言模式合成配置 ───
# 用于金丹合成/涌现推导的模型（可用较小模型以节省成本）
SYNTHESIS_MODEL=gpt-4o-mini

# ─── Go API 网关 ───
GO_PORT=8080
# Python 语言引擎地址（Go 调用）
PYTHON_ENGINE_BASE_URL=http://python-engine:8000

# ─── Python 语言引擎 ───
PYTHON_PORT=8000

# ─── Nginx ───
NGINX_PORT=80
